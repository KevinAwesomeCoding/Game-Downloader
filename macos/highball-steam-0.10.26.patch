+
+struct SteamCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "steam", abstract: "Resolve or launch this environment's Windows Steam.", subcommands: [Resolve.self, Launch.self, Game.self])
+
+    struct Resolve: ParsableCommand {
+        @Argument var bottle: String
+        func run() throws {
+            try printJSON(SteamExecutable.resolve(in: BottleStore().get(bottle)))
+        }
+    }
+
+    struct Launch: AsyncParsableCommand {
+        @Argument var bottle: String
+        @Option var uri: String = "steam://open/main"
+        @Flag(help: "Print the resolved request as JSON without launching or changing the environment.") var check = false
+        func run() async throws {
+            let b = try BottleStore().get(bottle)
+            let pin = try SteamExecutable.clientPin(in: b, uri: uri)
+            if check { try printJSON(Request(bottle: b.name, executable: pin.executableURL(driveC: b.driveC).path, arguments: pin.arguments)); return }
+            try await launch(pin, in: b)
+        }
+    }
+
+    struct Game: AsyncParsableCommand {
+        @Argument var bottle: String
+        @Argument var appID: Int
+        @Option(help: "Exact Steam-installed game folder to verify against Steam's own manifest.") var installPath: String
+        @Flag(help: "Report whether Steam records this exact installed game, without launching.") var check = false
+        func run() async throws {
+            let b = try BottleStore().get(bottle)
+            if b.settings.steamExecutableOverride != nil { _ = try SteamExecutable.resolve(in: b) }
+            let installed = SteamExecutable.installedGame(in: b, appID: appID, folder: URL(fileURLWithPath: installPath)) != nil
+            if check { try printJSON(["installed": installed]); return }
+            guard installed else { throw HighballError.failed("Steam does not record app \(appID) as installed at \(installPath) in \(b.name). Install and own the game through Windows Steam; a local copy cannot establish Steam authentication.") }
+            var pin = try SteamExecutable.pin(in: b)
+            pin.arguments += ["-applaunch", String(appID)]
+            let db = GameDB(directories: GameDB.defaultDirectories())
+            pin.environment.merge(b.settings.environment(forGame: db[appID]?.id)) { _, new in new }
+            try await launch(pin, in: b)
+        }
+    }
+
+    struct Request: Codable {
+        let bottle: String
+        let executable: String
+        let arguments: [String]
+    }
+
+    static func printJSON<T: Encodable>(_ value: T) throws {
+        print(String(decoding: try JSONEncoder().encode(value), as: UTF8.self))
+    }
+
+    static func launch(_ pin: Pin, in bottle: HighballKit.Bottle) async throws {
+        let executable = pin.executableURL(driveC: bottle.driveC)
+        // Resolve and validate before preflight can perform any runtime setup.
+        try SteamExecutable.validate(executable, in: bottle)
+        print("Steam executable: \(executable.path)")
+        let engine = try EngineStore().engine(bottle.settings.engineID)
+        let runner = WineRunner(engine: engine, bottle: bottle)
+        await BottleStore.preflight(runner: runner, bottle: bottle) { print($0) }
+        let result: LaunchResult
+        if let forwarded = try await runner.forwardToRunningSteam(pin.arguments) { result = forwarded }
+        else { result = try await runner.startResumingKnownSteamCrash(pin: pin, onOutput: { print($0) }).result }
+        print("exit=\(result.exitStatus) — log: \(result.log.path)")
+        if result.exitStatus != 0 { throw ExitCode(result.exitStatus) }
+    }
+}
