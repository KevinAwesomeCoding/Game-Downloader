diff --git a/Sources/HighballKit/SteamExecutable.swift b/Sources/HighballKit/SteamExecutable.swift
new file mode 100644
index 0000000..5b200d4
--- /dev/null
+++ b/Sources/HighballKit/SteamExecutable.swift
@@ -0,0 +1,80 @@
+import Foundation
+
+/// Steam's location belongs to the environment, shared by the GUI and CLI.
+/// Resolution is read-only: a stale recipe pin is never rewritten.
+public enum SteamExecutable {
+    public struct Resolution: Codable, Sendable {
+        public let path: String
+        public let source: String
+        public var url: URL { URL(fileURLWithPath: path) }
+    }
+
+    public static func validate(_ url: URL, in bottle: Bottle) throws {
+        guard url.lastPathComponent.lowercased() == "steam.exe",
+              PEExportName.isWindowsExecutable(at: url) else {
+            throw HighballError.failed("Steam executable is missing, unreadable, or not a Windows Steam.exe at: \(url.path). Open Highball > Settings > Environments > \(bottle.name) > Environment settings > Advanced > Steam executable. Choose Steam.exe or use automatic detection.")
+        }
+    }
+
+    public static func resolve(in bottle: Bottle) throws -> Resolution {
+        if let override = bottle.settings.steamExecutableOverride {
+            let url = Pin(name: "Steam", path: override).executableURL(driveC: bottle.driveC)
+            try validate(url, in: bottle) // An explicit choice must never silently fall back.
+            return Resolution(path: url.path, source: "override")
+        }
+        let pins = bottle.settings.pins.filter { $0.name.lowercased() == "steam" }
+            + bottle.settings.pins.filter { $0.name.lowercased() != "steam" && WineRunner.isSteamExecutable($0.path) }
+        var attempted: [String] = []
+        for pin in pins {
+            let url = pin.executableURL(driveC: bottle.driveC)
+            attempted.append(url.path)
+            if (try? validate(url, in: bottle)) != nil {
+                return Resolution(path: url.path, source: "pin")
+            }
+        }
+        for directory in ["Program Files (x86)", "Program Files"] {
+            var url = bottle.driveC
+            for component in [directory, "Steam", "steam.exe"] {
+                // Keep actual spelling even on a case-sensitive volume (Steam.exe).
+                let entries = (try? FileManager.default.contentsOfDirectory(at: url, includingPropertiesForKeys: nil)) ?? []
+                let actual = entries.first { $0.lastPathComponent == component }
+                    ?? entries.sorted { $0.path < $1.path }.first { $0.lastPathComponent.lowercased() == component.lowercased() }
+                url = url.appending(path: actual?.lastPathComponent ?? component)
+            }
+            attempted.append(url.path)
+            if (try? validate(url, in: bottle)) != nil {
+                return Resolution(path: url.path, source: "detected")
+            }
+        }
+        throw HighballError.failed("Windows Steam was not found in \(bottle.name). Attempted paths: \(attempted.joined(separator: "; ")). Open Highball > Settings > Environments > \(bottle.name) > Environment settings > Advanced > Steam executable and choose the existing Steam.exe.")
+    }
+
+    /// Keep the user's pin settings, replacing only the in-memory launch path.
+    public static func pin(in bottle: Bottle) throws -> Pin {
+        let resolved = try resolve(in: bottle)
+        var pin = bottle.settings.pins.first { $0.executableURL(driveC: bottle.driveC).standardizedFileURL == resolved.url.standardizedFileURL }
+            ?? bottle.settings.pins.first { $0.name.lowercased() == "steam" }
+            ?? Pin(name: "Steam", path: resolved.path)
+        pin.path = Pin.storagePath(for: resolved.url, driveC: bottle.driveC)
+        return pin
+    }
+
+    public static func clientPin(in bottle: Bottle, uri: String) throws -> Pin {
+        guard uri == "steam://open/main" || uri.range(of: #"^steam://install/[0-9]+$"#, options: .regularExpression) != nil else {
+            throw HighballError.failed("Unsupported Steam URI: \(uri)")
+        }
+        var pin = try pin(in: bottle)
+        pin.arguments.append(uri)
+        return pin
+    }
+
+    /// An app ID is only a hint. Steam's own install record and the exact folder must agree.
+    /// Ownership and sign-in are still checked by Steam when it handles -applaunch.
+    public static func installedGame(in bottle: Bottle, appID: Int, folder: URL) -> SteamGame? {
+        SteamLibrary.games(in: bottle).first {
+            $0.appid == appID && $0.isFullyInstalled && $0.installedByWindowsSteam
+                && $0.installFolder?.resolvingSymlinksInPath().standardizedFileURL == folder.resolvingSymlinksInPath().standardizedFileURL
+                && (try? folder.resourceValues(forKeys: [.isDirectoryKey]).isDirectory) == true
+        }
+    }
+}
